    </path>

    <!-- Right leg of M -->
    <path
        android:pathData="M70,72 L70,36 L78,36 L78,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="36"
                android:endX="78"
                android:endY="72"
                android:type="linear">
                <item android:color="#FF0D7C66" android:offset="0.0" />
                <item android:color="#FF14B8A6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dollar sign accent - vertical bar -->
    <path
        android:fillColor="#FF10B981"
        android:pathData="M52.5,33 L55.5,33 L55.5,39 L52.5,39 Z" />

