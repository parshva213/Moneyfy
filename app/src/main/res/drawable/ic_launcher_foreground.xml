    <path
        android:pathData="M30,72 L30,36 L38,36 L38,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="36"
                android:endX="78"
                android:endY="72"
                android:type="linear">
                <item android:color="#FF0D7C66" android:offset="0.0" />
                <item android:color="#FF14B8A6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left diagonal of M -->
    <path
        android:pathData="M30,36 L54,56 L46,56 L38,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="36"
                android:endX="78"
                android:endY="72"
                android:type="linear">
                <item android:color="#FF0D7C66" android:offset="0.0" />
                <item android:color="#FF14B8A6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right diagonal of M -->
    <path
        android:pathData="M78,36 L54,56 L62,56 L70,36 Z">
